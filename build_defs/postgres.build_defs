def postgres(name:str, version:str, os=None, arch=None, hashes:list=[], visibility:list=[], configure_flags:list=[], _compress:bool=False):
    """
    Builds PostgreSQL binaries from source for a specific OS and architecture.

    Args:
        name (str): Name of the rule.
        version (str): PostgreSQL version to build.
        os (str): Target operating system. Defaults to the current OS.
        arch (str): Target architecture. Defaults to the current architecture.
        hashes (list): Optional hashes to verify the download.
        visibility (list): Visibility declaration for the rule.
        configure_flags (list): Additional flags for PostgreSQL's configure script.
    """
    if not os:
        if CONFIG.OS == 'linux':
            os = 'linux'
        elif CONFIG.OS == 'darwin':
            os = 'darwin'
        else:
            raise ParseError(f'Unknown OS {CONFIG.OS}, you must pass explitly')
    if not arch:
        if CONFIG.ARCH == 'amd64':
            arch = 'x86_64'
        elif CONFIG.ARCH == 'arm64':
            arch = 'arm64'
        elif CONFIG.ARCH == 'x86':
            arch = 'i686'
        else:
            raise ParseError(f'Unknown architecture {CONFIG.ARCH}, you must pass explitly')
        
    target = f'{os}_{arch}'
    
    # Download the PostgreSQL source.
    url = f"https://ftp.postgresql.org/pub/source/v{version}/postgresql-{version}.tar.gz"
    download = remote_file(
        name=tag(name, f"download_{target}"),
        url=url,
        hashes=hashes,
    )
    # 
    extract = build_rule(
        name=name,
        tag=f'extract_{target}',
        srcs=[download],
        outs=[f'postgresql-{version}-{target}'],
        cmd = ' && '.join([
            'tar -xzf $SRC',
            f'mv postgresql-{version} $OUT'
        ]),
        building_description = f'Extracting PostgreSQL v{version} for {target}...',
    )
    # On macOS, Homebrew keg-only packages need explicit paths for configure to find them,
    # and /opt/homebrew/bin must be on PATH so pkg-config is available in the plz sandbox.
    env_prefix = ''
    srcs = [extract]
    src_dir = '$SRC'
    if CONFIG.OS == 'darwin':
        # Nothing from Homebrew: ICU is built here and linked in statically,
        # so the binaries load only macOS's own libraries (psql's line editing
        # is the system libedit).
        env_prefix = _DARWIN_ENV
        if _builds_with_icu(version):
            icu = _darwin_icu(tag(name, f'icu_{target}'))
            srcs = {'pg': [extract], 'icu': [icu]}
            src_dir = '$SRCS_PG'
            configure_flags = configure_flags + _darwin_icu_configure_args()

    install_cmds = [
        f'mkdir -p {target}/psql',
        f'cd {src_dir}',
        env_prefix + f'./configure --prefix "$HOME/{target}/psql" --with-uuid=e2fs ' + ' '.join(configure_flags),
        'make -j"$(getconf _NPROCESSORS_ONLN)" world-bin',
        'make install-world-bin',
    ]
    if CONFIG.OS == 'darwin':
        install_cmds.append(_darwin_relocate(f'$HOME/{target}/psql'))
    install_cmds.append('cd $HOME')

    install = build_rule(
        # Don't tag, --prefix doesn't recognise '#'.
        name=f'_{name}_{target}_install',
        srcs=srcs,
        outs = {
            "bin": [f'{target}/psql/bin'],
            "lib": [f'{target}/psql/lib'],
            "include": [f'{target}/psql/include'],
            "share": [f'{target}/psql/share'],
        },
        cmd = ' && '.join(install_cmds),
        build_timeout = 3600,
        building_description = f'Installing PostgreSQL v{version} for {target}...',
    )
    if _compress:
        tarball(
            name=name,
            out=f'psql-{version}-{target}.tar.gz',
            srcs=[
                install + '|bin',
                install + '|lib',
                install + '|include',
                install + '|share',
            ],
        )
    else:
        build_rule(
            name=name,
            srcs={
                "bin": [install + '|bin'],
                "lib": [install + '|lib'],
                "include": [install + '|include'],
                "share": [install + '|share'],
            },
            outs={
                "bin": [f'psql/bin'],
                "lib": [f'psql/lib'],
                "include": [f'psql/include'],
                "share": [f'psql/share'],
            },
            cmd='cp -r $SRCS_BIN $SRCS_LIB $SRCS_INCLUDE $SRCS_SHARE psql/',
            binary=True,
            visibility=visibility,
        )


def postgres_ai(name:str, version:str, pgvector_version:str="0.8.0", age_version:str="1.6.0-rc0", age_pg_major:str="PG17", os=None, arch=None, hashes:list=[], visibility:list=[], configure_flags:list=[], _compress:bool=False):
    """
    Builds PostgreSQL with all contrib modules plus pgvector and AGE extensions.

    Args:
        name: Name of the rule
        version: PostgreSQL version (e.g. "17.6")
        pgvector_version: pgvector version (e.g. "0.8.0")
        age_version: Apache AGE version (e.g. "1.6.0-rc0")
        age_pg_major: AGE's PG major version tag (e.g. "PG17")
        os: Target operating system. Defaults to current OS.
        arch: Target architecture. Defaults to current architecture.
        hashes: Optional hashes for the PostgreSQL source download
        visibility: Visibility declaration
        configure_flags: Additional flags for PostgreSQL's configure script
    """
    if not os:
        if CONFIG.OS == 'linux':
            os = 'linux'
        elif CONFIG.OS == 'darwin':
            os = 'darwin'
        else:
            raise ParseError(f'Unknown OS {CONFIG.OS}, you must pass explicitly')
    if not arch:
        if CONFIG.ARCH == 'amd64':
            arch = 'x86_64'
        elif CONFIG.ARCH == 'arm64':
            arch = 'arm64'
        elif CONFIG.ARCH == 'x86':
            arch = 'i686'
        else:
            raise ParseError(f'Unknown architecture {CONFIG.ARCH}, you must pass explicitly')

    target = f'{os}_{arch}'

    # Download PostgreSQL source
    pg_download = remote_file(
        name=tag(name, f"pg_download_{target}"),
        out=f"ai-postgresql-{version}.tar.gz",
        url=f"https://ftp.postgresql.org/pub/source/v{version}/postgresql-{version}.tar.gz",
        hashes=hashes,
    )

    # Download pgvector source
    pgvector_download = remote_file(
        name=tag(name, f"pgvector_download"),
        out=f"ai-pgvector-{pgvector_version}.tar.gz",
        url=f"https://github.com/pgvector/pgvector/archive/refs/tags/v{pgvector_version}.tar.gz",
    )

    # Download AGE source
    age_download = remote_file(
        name=tag(name, f"age_download"),
        out=f"ai-age-{age_version}.tar.gz",
        url=f"https://github.com/apache/age/archive/refs/tags/{age_pg_major}/v{age_version}.tar.gz",
    )

    env_prefix = ''
    ai_srcs = {
        "pg": [pg_download],
        "pgvector": [pgvector_download],
        "age": [age_download],
    }
    if CONFIG.OS == 'darwin':
        # As postgres(): ICU built here and linked in statically, nothing from
        # Homebrew.
        env_prefix = _DARWIN_ENV
        if _builds_with_icu(version):
            ai_srcs["icu"] = [_darwin_icu(tag(name, f'icu_{target}'))]
            configure_flags = configure_flags + _darwin_icu_configure_args()

    out_dir = f'ai-{target}'
    psql_dir = f'$HOME/{out_dir}/psql'
    install_cmds = [
        f'mkdir -p {out_dir}/psql',
        # Build and install PostgreSQL with all contrib modules
        'tar -xzf $SRCS_PG',
        f'cd postgresql-{version}',
        env_prefix + f'./configure --prefix "{psql_dir}" --with-uuid=e2fs ' + ' '.join(configure_flags),
        'make -j"$(getconf _NPROCESSORS_ONLN)" world-bin',
        'make install-world-bin',
        'cd $HOME',
        # Build and install pgvector
        'tar -xzf $SRCS_PGVECTOR',
        f'cd pgvector-{pgvector_version}',
        f"PG_CONFIG={psql_dir}/bin/pg_config make OPTFLAGS='-O2 -g'",
        f'PG_CONFIG={psql_dir}/bin/pg_config make install',
        'cd $HOME',
        # Build and install AGE
        'tar -xzf $SRCS_AGE',
        f'cd age-{age_pg_major}-v{age_version}',
        f"PG_CONFIG={psql_dir}/bin/pg_config make OPTFLAGS='-O2 -g'",
        f'PG_CONFIG={psql_dir}/bin/pg_config make install',
        'cd $HOME',
    ]

    if CONFIG.OS == 'darwin':
        install_cmds += [
            _darwin_relocate(psql_dir),
            # Create .dylib symlinks for extension .so files. PG16+ builds them
            # as .dylib on macOS already, so there may be no *.so: the loop
            # must not fail when the glob matches nothing.
            f'cd {psql_dir}/lib && for f in *.so; do if [ -f "$f" ]; then ln -sf "$f" "${{f%.so}}.dylib"; fi; done',
        ]

    install = build_rule(
        name=f'_{name}_{target}_install',
        srcs=ai_srcs,
        outs = {
            "bin": [f'{out_dir}/psql/bin'],
            "lib": [f'{out_dir}/psql/lib'],
            "include": [f'{out_dir}/psql/include'],
            "share": [f'{out_dir}/psql/share'],
        },
        cmd = ' && '.join(install_cmds),
        build_timeout = 3600,
        building_description = f'Installing PostgreSQL AI v{version} for {target}...',
    )
    if _compress:
        tarball(
            name=name,
            out=f'psql-ai-{version}-{target}.tar.gz',
            srcs=[
                install + '|bin',
                install + '|lib',
                install + '|include',
                install + '|share',
            ],
        )
    else:
        build_rule(
            name=name,
            srcs={
                "bin": [install + '|bin'],
                "lib": [install + '|lib'],
                "include": [install + '|include'],
                "share": [install + '|share'],
            },
            outs={
                "bin": [f'psql/bin'],
                "lib": [f'psql/lib'],
                "include": [f'psql/include'],
                "share": [f'psql/share'],
            },
            cmd='cp -r $SRCS_BIN $SRCS_LIB $SRCS_INCLUDE $SRCS_SHARE psql/',
            binary=True,
            visibility=visibility,
        )



# ICU, which PostgreSQL 16+ builds with by default, for the macOS binaries.
# Built from source as static libraries and linked into them, so they never
# depend on a Homebrew keg: Homebrew moves `icu4c` to each new major version
# and deprecates the old one, and a binary linked against
# /opt/homebrew/opt/icu4c@<N> stops starting when that keg goes.
_ICU_VERSION = "78.3"
_ICU_SHA256 = "3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0"

# The oldest macOS the binaries run on; without it, the build host's.
_DARWIN_ENV = 'export MACOSX_DEPLOYMENT_TARGET=14.0 && '


def _darwin_relocate(psql_dir:str):
    """Makes a macOS install load its own libraries relative to itself.

    make install records every library by its absolute path in the build
    directory, which exists only on the machine that built it: libpq for the
    binaries, dblink, postgres_fdw and libpqwalreceiver, and libpgtypes and
    libecpg for each other. Each library's own name becomes @rpath/<name>, and
    every reference to a library under the install becomes a path from the
    file that holds it (@loader_path/<relative path>/<name>).
    """
    return (
        'find ' + psql_dir + '/bin ' + psql_dir + '/lib -type f | while read -r f; do '
            'otool -h "$f" > /dev/null 2>&1 || continue; '
            'id=$(otool -D "$f" | sed -n 2p); '
            'case "$id" in ' + psql_dir + '/*) install_name_tool -id "@rpath/${id##*/}" "$f" ;; esac; '
            'otool -L "$f" | sed 1d | awk \'{print $1}\' | { grep "^' + psql_dir + '/" || true; } | { grep -vxF "$id" || true; } | while read -r dep; do '
                'rel=$(perl -MFile::Spec -e \'print File::Spec->abs2rel(@ARGV)\' "${dep%/*}" "${f%/*}"); '
                'install_name_tool -change "$dep" "@loader_path/$rel/${dep##*/}" "$f"; '
            'done; '
        'done'
    )


def _builds_with_icu(version:str):
    # configure turns ICU on by default from PostgreSQL 16; before that only
    # --with-icu does, which these builds do not pass.
    return int(version.split('.')[0]) >= 16


def _darwin_icu(name:str):
    # The install prefix: configure's --prefix does not take a '#'.
    prefix = name.lstrip('_').replace('#', '_') + f'-{_ICU_VERSION}'
    download = remote_file(
        name = tag(name, "download"),
        # Per caller: postgres() and postgres_ai() share a package.
        out = f"{prefix}-sources.tgz",
        url = f"https://github.com/unicode-org/icu/releases/download/release-{_ICU_VERSION}/icu4c-{_ICU_VERSION}-sources.tgz",
        hashes = [_ICU_SHA256],
    )
    return build_rule(
        name = name,
        srcs = [download],
        outs = [prefix],
        cmd = ' && '.join([
            'tar -xzf $SRC',
            'cd icu/source',
            # Static libraries with the data compiled in, so nothing is
            # loaded from disk at run time; no plugin loading, tests, samples
            # or the libraries PostgreSQL does not use.
            _DARWIN_ENV + f'./configure --prefix "$HOME/{prefix}" '
                '--enable-static --disable-shared --with-data-packaging=static --disable-dyload '
                '--disable-tests --disable-samples --disable-extras --disable-icuio --disable-layoutex',
            'make -j"$(getconf _NPROCESSORS_ONLN)"',
            'make install',
        ]),
        build_timeout = 3600,
        building_description = f'Building ICU {_ICU_VERSION}...',
    )


def _darwin_icu_configure_args():
    # Set, configure takes these instead of asking pkg-config. ICU is C++, so
    # the C++ runtime comes too: macOS's own libc++.
    icu = f'$HOME/$SRCS_ICU'
    return [
        f'ICU_CFLAGS="-I{icu}/include"',
        f'ICU_LIBS="-L{icu}/lib -licui18n -licuuc -licudata -lc++"',
    ]


RELEASE_VERSION = "v0.0.7"


def _resolve_target():
    if CONFIG.OS == "linux":
        return "linux_x86_64"
    elif CONFIG.OS == "darwin" and CONFIG.ARCH == "arm64":
        return "darwin_arm64"
    elif CONFIG.OS == "darwin":
        return "darwin_x86_64"
    else:
        fail(f"No prebuilt postgres binary for {CONFIG.OS}/{CONFIG.ARCH}")


def postgres_binary(name:str, version:str, hashes:list=[], visibility:list=[]):
    """
    Downloads pre-built PostgreSQL binaries (with all contrib modules) from GitHub releases.

    Args:
        name: Name of the rule
        version: PostgreSQL version (e.g. "17.6")
        hashes: Optional hashes for verification
        visibility: Visibility declaration
    """
    target = _resolve_target()

    tarball = remote_file(
        name = tag(name, "tarball"),
        url = f"https://github.com/becomeliminal/postgres/releases/download/{RELEASE_VERSION}/psql-{version}-{target}.tar.gz",
        hashes = hashes,
    )

    return build_rule(
        name = name,
        srcs = [tarball],
        outs = {
            "bin": ["psql/bin"],
            "lib": ["psql/lib"],
            "include": ["psql/include"],
            "share": ["psql/share"],
        },
        cmd = "mkdir -p psql && tar -xzf $SRC -C psql",
        binary = True,
        visibility = visibility,
    )


def postgres_ai_binary(name:str, version:str, hashes:list=[], visibility:list=[]):
    """
    Downloads pre-built PostgreSQL AI binaries (contrib + pgvector + AGE) from GitHub releases.

    Args:
        name: Name of the rule
        version: PostgreSQL version (e.g. "17.6")
        hashes: Optional hashes for verification
        visibility: Visibility declaration
    """
    target = _resolve_target()

    tarball = remote_file(
        name = tag(name, "tarball"),
        url = f"https://github.com/becomeliminal/postgres/releases/download/{RELEASE_VERSION}/psql-ai-{version}-{target}.tar.gz",
        hashes = hashes,
    )

    return build_rule(
        name = name,
        srcs = [tarball],
        outs = {
            "bin": ["psql/bin"],
            "lib": ["psql/lib"],
            "include": ["psql/include"],
            "share": ["psql/share"],
        },
        cmd = "mkdir -p psql && tar -xzf $SRC -C psql",
        binary = True,
        visibility = visibility,
    )
